# TILL testnet configuration
NEAR_NETWORK=testnet
NEAR_RPC=https://rpc.testnet.fastnear.com   # rpc.testnet.near.org is being retired

# The shop contract account (a sub-account, e.g. shop2.tillshop.testnet)
TILL_CONTRACT=shop2.tillshop.testnet
# Account that pays storage to create a brand-new shop account (deploy only)
TILL_FUND_FROM=

# Keys (ed25519:base58, from keys.json or your testnet setup)
TILL_OWNER_KEY=
TILL_CLERK_KEY=
TILL_CUSTOMER_KEY=

# Supplier account that receives COGS from the shop contract
TILL_SUPPLIER=vendorco.testnet

# Optional: LLM narration on clerk decisions (leave empty = fully deterministic)
OPENAI_API_KEY=
NEAR_AI_API_KEY=
TILL_MODEL=gpt-4o-mini

# Clerk loop period (ms)
TILL_TICK_MS=15000
PORT=8787
